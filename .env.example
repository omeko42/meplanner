# ==============================================================================
# MEPLANNER (MY EVENT PLANNER) — ENVIRONMENT VARIABLES TEMPLATE
# Commercial SaaS Edition by @omeko42
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# 1. NEVER commit real API keys, database URLs, or secrets to Git/GitHub.
# 2. For local development, copy this file to `.env.local` (which is git-ignored)
#    and fill in your actual credentials.
# 3. For production deployment, configure these variables directly inside
#    Vercel Project Settings -> Environment Variables.
#
# Values marked SERVER-ONLY must NEVER be prefixed with NEXT_PUBLIC_ — the
# NEXT_PUBLIC_ prefix ships the value to every browser.
# ==============================================================================

# ------------------------------------------------------------------------------
# Public (shipped to the browser — these are safe to expose)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://meplanner.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=wedding-media

# Cloudflare Turnstile site key (public — rendered in the widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Google OAuth client id (public)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (never expose to the browser)
# ------------------------------------------------------------------------------

# Supabase service_role key. Grants full database access — the server-side API
# routes use it to read/write data on behalf of an authenticated session.
# Find it: Supabase Dashboard -> Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# HMAC secret for the session cookie. Minimum 32 characters.
# Generate: openssl rand -base64 48
# Rotating this invalidates all existing sessions.
AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Comma-separated list of addresses allowed to act as the app owner
# (Superadmin). Leave empty to disable the superadmin identity entirely.
SUPERADMIN_EMAILS=owner@example.com

# Optional: superadmin login username (defaults to "superadmin").
SUPERADMIN_USERNAME=superadmin

# Optional: superadmin password. Prefer SUPERADMIN_PASSWORD_HASH (scrypt).
# Leaving both unset keeps the built-in hash, which is fine but cannot be
# rotated without a code change.
# SUPERADMIN_PASSWORD=
# SUPERADMIN_PASSWORD_HASH=scrypt$salt$hash

# ------------------------------------------------------------------------------
# Cloudflare Turnstile (server-side secret)
# ------------------------------------------------------------------------------
# The secret used to verify tokens against Cloudflare. When it is missing,
# Turnstile is not enforced — set TURNSTILE_REQUIRED=true to fail closed in
# environments where the captcha must be mandatory.
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
TURNSTILE_REQUIRED=false

# ------------------------------------------------------------------------------
# Resend (transactional email)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=MEPlanner <no-reply@your-domain.com>
# EMAIL_REPLY_TO=support@your-domain.com

# ------------------------------------------------------------------------------
# Payment verification
# ------------------------------------------------------------------------------
# Comma-separated list of wallet addresses that may receive crypto payments.
# An empty list means no crypto payment can be verified on-chain.
PAYMENT_CRYPTO_RECIPIENTS=your-wallet-address-1,your-wallet-address-2

# ------------------------------------------------------------------------------
# Optional hardening
# ------------------------------------------------------------------------------
# Extra origins allowed to make credentialed requests, comma-separated.
# ALLOWED_ORIGINS=https://meplanner.vercel.app

# Set to true to allow the demo accounts to log in. Never enable in production.
ENABLE_DEMO_LOGIN=false

# Set to false only when NOT running behind a trusted proxy (Vercel/Cloudflare),
# otherwise clients can spoof their IP address.
# TRUST_PROXY_HEADERS=true
